class Solution:
    def plusOne(self, digits: List[int]) -> List[int]:
        n = len(digits)
        nums = 0
        new = []

        for i in range(1,n+1):
            nums = nums + digits[i-1]*(10**(n-i))
        nums = nums + 1

        print(nums)
        n2 = abs(len(str(nums)))
        
        for j in range(n2):
            r = nums%10
            print(r)
            nums = nums//10
            new.insert(0, r)

        return new
