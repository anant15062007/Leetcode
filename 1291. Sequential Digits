class Solution:
    def sequentialDigits(self, low: int, high: int) -> List[int]:
        
        n = '123456789'
        result = []

        for i in range(0, 9):
            for j in range(i, 9):
                num = int(n[i : j+1])
                if low <= num <= high:
                    result.append(num)
                    
        result.sort()
        return result
