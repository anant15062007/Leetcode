class Solution:
    def searchRange(self, nums: List[int], target: int) -> List[int]:
        
        count = -1
        result = [-1,-1]

        for i in range(len(nums)):
            if nums[i]==target:
                count +=1
                if count == 0:
                    result[0] = i
                elif count == 1:
                    result[1] = i
                elif count>1:
                    result[1] = i
                else:
                    print("Error")
            else:
                continue

        if result[0]!=-1 and result[1]==-1:
            result[1]=result[0]
        elif result[0]==-1 and result[1]!=-1:
            result[0]=result[1]
        # else:
        #     continue

        return result
