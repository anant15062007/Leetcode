class Solution:
    def minOperations(self, nums: List[int]) -> int:

        count_of_one = 0
        count_of_non_one = 0

        for i in nums:
            if i==1:
                count_of_one += 1
            else:
                count_of_non_one += 1

        if count_of_one>0:
            return count_of_non_one
        
        list_of_subarray = []

        for i in range(len(nums)):
            for j in range(i+1, len(nums) + 1):
                if len(nums[i:j]) < 2:
                    continue
                else:
                    list_of_subarray.append(nums[i:j])

        print(list_of_subarray)
        shortest_len = 100
        shortest_subarray = []

        for subarray in list_of_subarray:
            if math.gcd(*subarray)==1:
                if len(subarray)<shortest_len:
                    shortest_len = len(subarray)
                    shortest_subarray = subarray
        
        print(shortest_subarray)
        print(shortest_len)


        if shortest_len == 100:
            return -1
        else:
            return len(nums)+shortest_len-2
