        while i < n - 1:
            if math.gcd(nums[i], nums[i+1]) == 1:
                if nums[i] == 1 and nums[i+1] == 1:
                    i += 1
                    continue
                if nums[i] == 1:
                    nums[i+1] = 1
                else:
                    nums[i] = 1
                    
                count += 1
                
                if all(x == 1 for x in nums):
                    return count
                i = 0 
                continue
            elif i + 2 < n and math.gcd(nums[i], nums[i+1], nums[i+2])==1:
                nums[i+1]=math.gcd(nums[i], nums[i+1])
                count += 1
                i = 0
                continue
            i += 1

        return -1
