class Solution:
    def numSub(self, s: str) -> int:

        s = s + "0"
        n = 0
        final = 0

        for i in s:
            print(i)
            print(n)
            if i=="1":
                n+=1
            else:
                final = final +  (n + 1) * n // 2
                n = 0
            
        return final%(10**9 + 7)
