class Solution:
    def numSub(self, s: str) -> int:
        
        s_perm = []

        if len(s) > 10**5:
            return 10**9 + 7

        for i in range(len(s)):
            for j in range(i+1, len(s)+1):
                if all(x=="1" for x in s[i:j]):
                    s_perm.append(s[i:j])

        return len(s_perm)
