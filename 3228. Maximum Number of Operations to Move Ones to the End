class Solution:
    def maxOperations(self, s: str) -> int:

        n = len(s)
        count = 0
        s_list = list(s)
       
        for i in range(n):
            if s[i] == "0":
                continue
            else:
                for j in range(i+1,n):
                    if s[j] == "0":
                        continue
                    elif s_list[i] == "1" and s_list[j-1] == "0":
                        s_list[i], s_list[j-1] = s_list[j-1], s_list[i]
                        
                        count += 1
                        break
        result = "".join(s_list)
        print(result)
        return(count)
