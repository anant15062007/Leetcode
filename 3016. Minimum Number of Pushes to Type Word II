class Solution:
    def minimumPushes(self, word: str) -> int:
        
        freq = {}

        for c in word:
            freq[c] = freq.get(c, 0) + 1

        nums = sorted(freq.values(), reverse=True)

        ans = 0
        for i, f in enumerate(nums):
            ans += f * (i // 8 + 1)

        return ans
