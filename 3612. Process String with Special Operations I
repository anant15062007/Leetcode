class Solution:
    def processStr(self, s: str) -> str:
        
        result = ''

        for i in s:
            if i=='*':
                if len(result)!=0:
                    result = result[:-1]
            elif i=='#':
                result = result + result
            elif i=='%':
                result = result[::-1]
            else:
                result = result + i

        return result
