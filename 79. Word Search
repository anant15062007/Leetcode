class Solution:
    def exist(self, board: List[List[str]], word: str) -> bool:

        used_item = []
        def neighbors_match(x: int, y: int, input: int) -> bool:
            used_item.append([x,y])
            print("in fn", x,y,input)
            success = False
            if input>len(word)-1:
                print("condn met",input)
                return True
            if x>0:
                if word[input]==board[y][x-1]: #Left
                    print("in left",used_item)
                    if [x-1, y] in used_item:
                        success = False
                    else:
                        if neighbors_match(x-1, y, input+1):
                            success = True
            if x<n-1:
                if word[input]==board[y][x+1]: #Right
                    print("in right",used_item)
                    if [x+1,y] in used_item:
                        success = False
                    else:
                        if neighbors_match(x+1, y, input+1):
                            success = True
            if y<m-1:
                if word[input]==board[y+1][x]: #Bottom
                    print("in bottom",used_item)
                    if [x, y+1] in used_item:
                        success = False
                    else:
                        if neighbors_match(x, y+1, input+1):
                            success = True
            if y>0:
                if word[input]==board[y-1][x]: #Top
                    print("in top",used_item)
                    if [x,y-1] in used_item:
                        success = False
                    else:
                        if neighbors_match(x, y-1, input+1):
                            success = True
            if not success:
                used_item.remove([x,y])
            return success

        
        found = False
        m = len(board)
        n = len(board[0])

        for y in range(m):
            for x in range(n):
                if word[0] == board[y][x]:
                    #print("match",x,y)
                    used_item.clear()
                    found = neighbors_match(x, y, 1)
                    if not found:
                        print("In cont")
                        continue
                    else:
                        print("In else")
                        return found
        return found
