class Solution:
    def longestBalanced(self, s: str) -> int:
        
        maxlen = 0
        # substrings = []
        for i in range(len(s)):
            
            num = 0
            for j in range(i + 1, len(s) + 1):
                numbers = list(Counter(s[i:j]).values())
                if len(set(numbers)) == 1:
                    if j-i>maxlen:
                        maxlen = j-i
                        # print("Numbers:", numbers)
                        # print(maxlen)
        return maxlen
