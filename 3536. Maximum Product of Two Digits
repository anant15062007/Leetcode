class Solution:
    def maxProduct(self, n: int) -> int:
        
        maxProduct = 0
        intArr = []
        while n>0:
            temp = n%10
            intArr.append(temp)
            n = n//10
        
        print(intArr)

        for i in range(len(intArr)):
            for j in range(i+1, len(intArr)):
                if intArr[i]*intArr[j]>maxProduct:
                    maxProduct = intArr[i]*intArr[j]
                
        return maxProduct
