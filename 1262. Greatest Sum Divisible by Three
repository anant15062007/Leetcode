        copy = sum

        print(sum)

        while copy%3!=0:
            copy-=1
        print(copy)
        print(nums)

        i = 0
        diff = sum - copy

        if diff == 0:
            return copy

        while copy >= 0:
            diff = sum - copy
            print(diff)
            for j in range(min(n, 10)):
                for k in range(j+1, min(n, 10)):
                    print(j)
