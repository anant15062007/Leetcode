class Solution:
    def gcdOfOddEvenSums(self, n: int) -> int:
        
        sumOdd = 0
        sumEven = 0
                
        e = 2
        o = 1

        gcd = 0

        for i in range(n):
            sumOdd += o
            sumEven += e
            e = e+2
            o = o+2

        for j in range(1, min(e,o)):
            if sumEven%j==0 and sumOdd%j==0:
                if j>gcd:
                    gcd = j
                
        return gcd
