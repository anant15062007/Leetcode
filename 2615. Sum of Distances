class Solution:
    def distance(self, nums: List[int]) -> List[int]:
        
        arr = []
        index = []
        value = 0
        print(len(nums))
        if len(nums)>10**5 or len(nums)<1:
            return 0

        for i in range(len(nums)):
            for j in range(len(nums)):
                if nums[i] == nums[j]:
                    index.append(j)
            for k in index:
                value = value + abs(i-k)
            arr.append(value)
            index = []
            value = 0
        return arr
