class Solution:
    def checkDivisibility(self, n: int) -> bool:
        self.digits = []
        self.value = 0
        
        self.get_digits(n)
        self.get_sum(self.digits)

        print(self.digits)
        print(self.value)
        
        if n%self.value == 0:
            return True
        else:
            return False

    def get_digits(self, num: int):
        while num > 0:
            i = num % 10
            num = num // 10
            self.digits.append(i)

    def get_sum(self, nums:list[int]):
        add = 0
        product = 1
        for i in nums:
            add += i
            product *= i
        self.value = add + product
