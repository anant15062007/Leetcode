class Solution:
    def intersectionSizeTwo(self, intervals: List[List[int]]) -> int:
        nums = []
        my_intervals = intervals
        run = 1

        while len(my_intervals)!=0:
            min = 10**8
            max = 0
            for i in range(len(my_intervals)):
                if my_intervals[i][1]>max:
                    max = my_intervals[i][1]
                if my_intervals[i][0]<min:
                    min = my_intervals[i][0]

            def how_many_belongs(self, my_intervals: List[List[int]], integer_at: int) -> int:
                count = 0
                for j in range(len(my_intervals)):
                    if my_intervals[j][0]<=integer_at<=my_intervals[j][1]:
                        count += 1
                return count

            max_count = 0
            max_value = 0
            count = 0
            for i in range(min, max+1):
                count = how_many_belongs(self, my_intervals, i)

                if count>max_count and i not in nums:
                    max_count = count
                    max_value = i


            if run==1:
                max_count2 = 0
                max_value2 = 0
                count2 = 0
                for i in range(min, max+1):
                    if i!=max_value:
                        count2 = how_many_belongs(self, my_intervals, i)

                        if count2>max_count2:
                            max_count2 = count2
                            max_value2 = i
                nums.append(max_value2)

            print("MaxValue: ", max_value, " MaxCount: ", max_count)
            nums.append(max_value)
            print("Num: ", nums)
            

            def pop_match(self, my_intervals: List[List[int]], nums: List[int]):
                count = 0
                index = []
                for i in range(len(my_intervals)):
                    count = 0
                    for j in nums:
                        if my_intervals[i][0]<=j<=my_intervals[i][1]:
                            count += 1
                            if count == 2:
                                index.append(i)
                                break
                if len(index) != 0:
                    for k in sorted(index, reverse=True):
                        my_intervals.pop(k)

                    
            pop_match(self, my_intervals, nums)

            print("New MyIntervals: ", my_intervals)
            run +=1

        return(len(nums))
